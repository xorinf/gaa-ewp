# Port the server listens on. Render sets this automatically.
PORT=3000

# Secret used to sign the session cookie. Use any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a random secret is generated and stored on disk.
SESSION_SECRET=

# Folder that holds the XML data files.
# On Render, point this at your persistent disk mount, for example:
#   DATA_DIR=/var/data
# Leave empty to use backend/data inside the project.
DATA_DIR=

# Set to "production" when deploying. Adds the Secure flag to the session cookie.
NODE_ENV=development
